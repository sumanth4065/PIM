<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RunSettingsFilePath>$(MSBuildProjectDirectory)\PIMQAAutomation.runsettings</RunSettingsFilePath>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Modules\Alternate\**" />
		<Compile Remove="Modules\Item\**" />
		<Compile Remove="Resources\**" />
		<EmbeddedResource Remove="Modules\Alternate\**" />
		<EmbeddedResource Remove="Modules\Item\**" />
		<EmbeddedResource Remove="Resources\**" />
		<None Remove="Modules\Alternate\**" />
		<None Remove="Modules\Item\**" />
		<None Remove="Resources\**" />
		<SpecFlowFeatureFiles Remove="Modules\Alternate\**" />
		<SpecFlowFeatureFiles Remove="Modules\Item\**" />
		<SpecFlowFeatureFiles Remove="Resources\**" />
		<SpecFlowObsoleteCodeBehindFiles Remove="Modules\Alternate\**" />
		<SpecFlowObsoleteCodeBehindFiles Remove="Modules\Item\**" />
		<SpecFlowObsoleteCodeBehindFiles Remove="Resources\**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.2.2" />
		<PackageReference Include="Azure.Identity" Version="1.13.2" />
		<PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
		<PackageReference Include="EPPlus" Version="7.4.0" />
		<PackageReference Include="ExtentReports" Version="4.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="9.0.2" />
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.47.2" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="Microsoft.Playwright" Version="1.51.0" />
		<PackageReference Include="Microsoft.Playwright.NUnit" Version="1.51.0" />
		<PackageReference Include="PlaywrightFramework" Version="1.1.0" />
		<PackageReference Include="PPT.Integration.CommonDataModel" Version="6.3.336" />
		<PackageReference Include="RestSharp" Version="112.1.0" />
		<PackageReference Include="Serilog" Version="4.2.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="SpecFlow.Actions.Playwright" Version="0.1.285" />
		<PackageReference Include="SpecFlow.Plus.LivingDocPlugin" Version="3.9.57" />
		<PackageReference Include="SpecFlow.NUnit" Version="3.9.40" />
		<PackageReference Include="nunit" Version="3.13.2" />
		<PackageReference Include="NUnit3TestAdapter" Version="4.1.0" />
		<PackageReference Include="FluentAssertions" Version="6.12.0" />

		<PackageReference Include="PIM.Domain" Version="2.0.34-CI-20250611-111339" />
		<PackageReference Include="PIM.Services" Version="2.0.34-CI-20250611-111339" />
		<PackageReference Include="PIM.Core.Common" Version="2.0.34-CI-20250611-111339" />
		<PackageReference Include="PIM.Data" Version="2.0.34-CI-20250611-111339" />

	</ItemGroup>

	<ItemGroup>
		<Folder Include="Modules\AdminTool\Features\" />
		<Folder Include="Modules\AdminTool\Constants\" />
		<Folder Include="Modules\AdminTool\Resources\" />
		<Folder Include="Modules\Bom\Features\" />
		<Folder Include="Modules\Bom\Resources\DevImport\Asset\" />
		<Folder Include="Modules\Bom\Resources\DevImport\Part\" />
		<Folder Include="Modules\Bom\Resources\DevImport\Product\" />
		<Folder Include="Modules\Bom\Resources\TestData\" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="PIMQAAutomation.runsettings">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
